# Database credentials
DB_HOST=your_database_host_here
DB_PORT=your_database_port_here
DB_USER=your_database_user_here
DB_PASSWORD=your_database_password_here
DB_DATABASE=your_database_name_here

# node-pg-migrate reads this line to apply migrations
DATABASE_URL=postgresql://your_local_user:your_local_password@localhost:5432/expense_tracker

ACCESS_TOKEN_SECRET=your_access_token_secret_here

# bcrypt cost factor: how many hashing rounds (2^SALT_ROUNDS) are applied when
# hashing passwords. Higher = more secure but slower. 10-12 is the usual range.
SALT_ROUNDS=10
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

PORT=3000
AI_SERVICE_URL=http://127.0.0.1:8000
RESET_TOKEN_TTL_MINUTES=10

RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
